// --- MAPEAMENTO DE PINOS NO ESP32 ---
const int PIN_LED_R       = 25; // Pino Vermelho do LED RGB
const int PIN_LED_G       = 26; // Pino Verde do LED RGB
const int PIN_LED_B       = 27; // Pino Azul do LED RGB
const int PIN_POT         = 34; // Potenciômetro (ADC1)
const int PIN_LDR         = 35; // Fotorresistor LDR (ADC1)
const int PIN_TEMP        = 32; // Sensor NTC (ADC1)
const int PIN_BUZZER      = 33; // Buzzer
const int PIN_BOTÃO       = 14; // Botão (Interrupção externa)

// Limite de luminosidade do Fotorresistor (0 a 4095)
const int LIMITE_LDR_ESCURO = 2000;

// --- VARIÁVEIS DE ESTADO E BANDEIRAS ---
bool ativadoTemperatura = true;
bool ativadoDetector    = true;
bool ativadoBuzzer      = true;
bool ligadoPainel       = true;

volatile bool sistemaAtivoBotao = true; 
volatile unsigned long ultimoDebounceTempo = 0;
const unsigned long DEBOUNCE_DELAY = 250; 

unsigned long tempoPiscaRGB = 0;
bool modoTemporizadoRGB     = false;

// --- INTERRUPÇÃO EXTERNA (ISR) PARA O BOTÃO ---
void IRAM_ATTR tratarInterrupcaoBotao() {
  unsigned long tempoAtual = millis();
  if (tempoAtual - ultimoDebounceTempo > DEBOUNCE_DELAY) {
    sistemaAtivoBotao = !sistemaAtivoBotao;
    ultimoDebounceTempo = tempoAtual;
  }
}

// --- LEITURA DO NTC NO WOKWI (-24°C a 80°C) ---
float lerTemperaturaC(int pino) {
  int leituraADC = analogRead(pino);

  if (leituraADC <= 0) return 80.0;
  if (leituraADC >= 4095) return -24.0;

  float tensao = leituraADC * (3.3 / 4095.0);
  float rNTC = 10000.0 * (tensao / (3.3 - tensao));

  float tempK = 1.0 / ( (1.0 / 298.15) + (1.0 / 3950.0) * log(rNTC / 10000.0) );
  float tempC = tempK - 273.15;

  return constrain(tempC, -24.0, 80.0);
}

// --- CONFIGURAÇÃO DAS CORES DO LED RGB ---
void definirCorRGB(int r, int g, int b) {
  ledRAtual = r;
  ledGAtual = g;
  ledBAtual = b;
  analogWrite(PIN_LED_R, r);
  analogWrite(PIN_LED_G, g);
  analogWrite(PIN_LED_B, b);
}

void enviarLeitura(float temperaturaC, int luminosidadeAdc, int potenciometroAdc,
                   bool sistemaAtivo, bool buzzerSoando) {
  if (strcmp(SUPABASE_ANON_KEY, "COLE_A_CHAVE_ANON_PUBLICA_AQUI") == 0) {
    Serial.println("Supabase nao configurado: preencha SUPABASE_ANON_KEY.");
    return;
  }

  if (WiFi.status() != WL_CONNECTED) {
    Serial.println("Leitura nao enviada: Wi-Fi desconectado.");
    return;
  }

  if (time(nullptr) < 1700000000) {
    Serial.println("Leitura nao enviada: aguardando sincronizacao do horario.");
    return;
  }

  WiFiClientSecure clienteSeguro;
  clienteSeguro.setCACert(SUPABASE_ROOT_CA);

  HTTPClient http;
  const String endpoint = String(SUPABASE_URL) + "/rest/v1/leituras";
  if (!http.begin(clienteSeguro, endpoint)) {
    Serial.println("Nao foi possivel iniciar a requisicao HTTPS ao Supabase.");
    return;
  }

  http.setTimeout(5000);
  http.addHeader("Content-Type", "application/json");
  http.addHeader("apikey", SUPABASE_ANON_KEY);
  http.addHeader("Authorization", String("Bearer ") + SUPABASE_ANON_KEY);
  http.addHeader("Prefer", "return=minimal");

  String temperaturaJson = ativadoTemperatura ? String(temperaturaC, 2) : "null";
  String payload = "{\"dispositivo_id\":" + String(DISPOSITIVO_ID) +
      ",\"temperatura_c\":" + temperaturaJson +
      ",\"luminosidade_adc\":" + String(luminosidadeAdc) +
      ",\"potenciometro_adc\":" + String(potenciometroAdc) +
      ",\"sistema_ativo\":" + String(sistemaAtivo ? "true" : "false") +
      ",\"temperatura_sensor_ativo\":" + String(ativadoTemperatura ? "true" : "false") +
      ",\"detector_ativo\":" + String(ativadoDetector ? "true" : "false") +
      ",\"buzzer_habilitado\":" + String(ativadoBuzzer ? "true" : "false") +
      ",\"painel_ligado\":" + String(ligadoPainel ? "true" : "false") +
      ",\"led_ligado\":" + String((ledRAtual || ledGAtual || ledBAtual) ? "true" : "false") +
      ",\"led_r\":" + String(ledRAtual) +
      ",\"led_g\":" + String(ledGAtual) +
      ",\"led_b\":" + String(ledBAtual) +
      ",\"buzzer_soando\":" + String(buzzerSoando ? "true" : "false") + "}";

  int codigoHttp = http.POST(payload);
  if (codigoHttp >= 200 && codigoHttp < 300) {
    Serial.println("Leitura enviada ao Supabase.");
  } else if (codigoHttp > 0) {
    Serial.print("Supabase respondeu HTTP ");
    Serial.print(codigoHttp);
    Serial.print(": ");
    Serial.println(http.getString());
  } else {
    Serial.print("Falha ao enviar leitura: ");
    Serial.println(http.errorToString(codigoHttp));
  }

  http.end();
}

void definirCorPorEspectro(int valorPot) {
  if (valorPot < 819) {
    definirCorRGB(255, 0, 0);       // Vermelho
  } else if (valorPot < 1638) {
    definirCorRGB(255, 127, 0);     // Laranja
  } else if (valorPot < 2457) {
    definirCorRGB(255, 255, 0);     // Amarelo
  } else if (valorPot < 3276) {
    definirCorRGB(255, 255, 255);   // Branco
  } else if (valorPot < 3685) {
    definirCorRGB(0, 255, 255);     // Azul Turquesa
  } else {
    definirCorRGB(0, 0, 255);       // Azul
  }
}

// --- COMANDOS DO PAINEL / MONITOR SERIAL ---
void processarComando(String cmd) {
  cmd.trim();
  if (cmd.equalsIgnoreCase("Ligar")) {
    ligadoPainel = true;
  } else if (cmd.equalsIgnoreCase("Desligar")) {
    ligadoPainel = false;
  } else if (cmd.equalsIgnoreCase("Vermelho")) {
    definirCorRGB(255, 0, 0);
    modoTemporizadoRGB = true;
    tempoPiscaRGB = millis();
  } else if (cmd.equalsIgnoreCase("Amarelo")) {
    definirCorRGB(255, 255, 0);
    modoTemporizadoRGB = true;
    tempoPiscaRGB = millis();
  } else if (cmd.equalsIgnoreCase("Azul")) {
    definirCorRGB(0, 0, 255);
    modoTemporizadoRGB = true;
    tempoPiscaRGB = millis();
  } else if (cmd.equalsIgnoreCase("Desativar Temperatura")) {
    ativadoTemperatura = false;
  } else if (cmd.equalsIgnoreCase("Ativar Temperatura")) {
    ativadoTemperatura = true;
  } else if (cmd.equalsIgnoreCase("Desativar Detector")) {
    ativadoDetector = false;
  } else if (cmd.equalsIgnoreCase("Ativar Detector")) {
    ativadoDetector = true;
  } else if (cmd.equalsIgnoreCase("Desativar Buzzer")) {
    ativadoBuzzer = false;
  } else if (cmd.equalsIgnoreCase("Ativar Buzzer")) {
    ativadoBuzzer = true;
  }
}

void manterConexaoWiFi() {
  static unsigned long ultimaTentativa = 0;
  if (WiFi.status() == WL_CONNECTED ||
      millis() - ultimaTentativa < INTERVALO_ENVIO_MS) {
    return;
  }

  ultimaTentativa = millis();
  Serial.println("Reconectando ao Wi-Fi...");
  WiFi.begin(WIFI_SSID, WIFI_PASSWORD);
}

void setup() {
  Serial.begin(115200);

  WiFi.mode(WIFI_STA);
  WiFi.begin(WIFI_SSID, WIFI_PASSWORD);
  configTime(0, 0, "pool.ntp.org", "time.nist.gov");
  Serial.println("Conectando ao Wi-Fi para enviar dados ao Supabase...");

  pinMode(PIN_LED_R, OUTPUT);
  pinMode(PIN_LED_G, OUTPUT);
  pinMode(PIN_LED_B, OUTPUT);
  pinMode(PIN_BUZZER, OUTPUT);
  
  pinMode(PIN_POT, INPUT);
  pinMode(PIN_LDR, INPUT);
  pinMode(PIN_TEMP, INPUT);

  pinMode(PIN_BOTÃO, INPUT_PULLUP);
  attachInterrupt(digitalPinToInterrupt(PIN_BOTÃO), tratarInterrupcaoBotao, FALLING);

  Serial.println("--- Sistema de Lâmpada Inteligente Inicializado ---");
}

void loop() {
  manterConexaoWiFi();

  if (Serial.available() > 0) {
    String comando = Serial.readStringUntil('\n');
    processarComando(comando);
  }

  float tempC = lerTemperaturaC(PIN_TEMP);
  int valorLDR = analogRead(PIN_LDR);
  int valorPot = analogRead(PIN_POT);

  bool emPerigoTemp = (tempC < 0.0 || tempC > 25.0);
  bool ambienteEscuro = (valorLDR > LIMITE_LDR_ESCURO);

  static unsigned long ultimoPrint = 0;
  if (millis() - ultimoPrint > 1000) {
    ultimoPrint = millis();

    Serial.print("Temperatura: ");
    if (ativadoTemperatura) {
      Serial.print(tempC, 1);
      Serial.print(" °C");
      if (emPerigoTemp) {
        Serial.print(" -> Perigo! Desligar!");
      }
    } else {
      Serial.print("[SENSOR DESATIVADO]");
    }
    Serial.println();

    bool deveLigarRGB = ligadoPainel && sistemaAtivoBotao && 
                        (!ativadoTemperatura || !emPerigoTemp) && 
                        (!ativadoDetector || ambienteEscuro);

    Serial.print("Estado LED RGB: ");
    Serial.println(deveLigarRGB ? "ON (ligado)" : "OFF (desligado)");
    Serial.println("------------------------------------------");
  }

  bool buzzerSoando = ativadoBuzzer && ativadoTemperatura &&
                      emPerigoTemp && sistemaAtivoBotao;
  if (buzzerSoando) {
    tone(PIN_BUZZER, 1000);
  } else {
    noTone(PIN_BUZZER);
  }

  if (modoTemporizadoRGB) {
    if (millis() - tempoPiscaRGB > 1000) {
      modoTemporizadoRGB = false;
    }
  } else {
    if (!sistemaAtivoBotao || !ligadoPainel || (ativadoTemperatura && emPerigoTemp) || (ativadoDetector && !ambienteEscuro)) {
      definirCorRGB(0, 0, 0);
    } else {
      definirCorPorEspectro(valorPot);
    }
  }

  static unsigned long ultimoEnvio = 0;
  if (millis() - ultimoEnvio >= INTERVALO_ENVIO_MS) {
    ultimoEnvio = millis();
    bool sistemaAtivo = sistemaAtivoBotao && ligadoPainel;
    enviarLeitura(tempC, valorLDR, valorPot, sistemaAtivo, buzzerSoando);
  }

  delay(50);
}

#include "thingProperties.h"
#include <Arduino.h>

// --- MAPEAMENTO DE PINOS NO ESP32 ---
const int PIN_LED_R  = 25;
const int PIN_LED_G  = 26;
const int PIN_LED_B  = 27;
const int PIN_POT    = 34; // ADC1
const int PIN_LDR    = 35; // ADC1
const int PIN_TEMP   = 32; // ADC1
const int PIN_BUZZER = 33;
const int PIN_BOTAO  = 14;

const int LIMITE_LDR_ESCURO = 2000;

// --- VARIÁVEIS DE CONTROLE LOCAL ---
volatile bool sistemaAtivoBotao = true;
volatile unsigned long ultimoDebounceTempo = 0;
const unsigned long DEBOUNCE_DELAY = 250;

unsigned long tempoPiscaRGB = 0;
bool modoTemporizadoRGB     = false;

// --- ISR DO BOTÃO FÍSICO ---
void IRAM_ATTR tratarInterrupcaoBotao() {
  unsigned long tempoAtual = millis();
  if (tempoAtual - ultimoDebounceTempo > DEBOUNCE_DELAY) {
    sistemaAtivoBotao = !sistemaAtivoBotao;
    ultimoDebounceTempo = tempoAtual;
  }
}

// --- LEITURA DO NTC (10k + resistor 10k) ---
float lerTemperaturaC(int pino) {
  int leituraADC = analogRead(pino);
  if (leituraADC <= 0)    return 80.0;
  if (leituraADC >= 4095) return -24.0;

  float tensao = leituraADC * (3.3 / 4095.0);
  float rNTC   = 10000.0 * (tensao / (3.3 - tensao));
  float tempK  = 1.0 / ( (1.0 / 298.15) + (1.0 / 3950.0) * log(rNTC / 10000.0) );
  float tempC  = tempK - 273.15;

  return constrain(tempC, -24.0, 80.0);
}

// --- LED RGB E ATUALIZAÇÃO DE COR NA NUVEM ---
void definirCorRGB(int r, int g, int b, String nomeCor) {
  analogWrite(PIN_LED_R, r);
  analogWrite(PIN_LED_G, g);
  analogWrite(PIN_LED_B, b);

  // Atualiza a variável da nuvem apenas se houve mudança real
  if (corAtual != nomeCor) {
    corAtual = nomeCor;
  }
}

void definirCorPorEspectro(int valorPot) {
  if (valorPot < 819)       definirCorRGB(255, 0, 0, "Vermelho");
  else if (valorPot < 1638) definirCorRGB(255, 127, 0, "Laranja");
  else if (valorPot < 2457) definirCorRGB(255, 255, 0, "Amarelo");
  else if (valorPot < 3276) definirCorRGB(255, 255, 255, "Branco");
  else if (valorPot < 3685) definirCorRGB(0, 255, 255, "Ciano");
  else                      definirCorRGB(0, 0, 255, "Azul");
}

// --- PROCESSAMENTO DE COMANDOS (SERIAL OU NUVEM) ---
void processarComando(String cmd) {
  cmd.trim();
  if (cmd.equalsIgnoreCase("Ligar")) {
    ligadoPainel = true;
    Serial.println("[CMD] Ligar -> painel ON");
  } else if (cmd.equalsIgnoreCase("Desligar")) {
    ligadoPainel = false;
    Serial.println("[CMD] Desligar -> painel OFF");
  } else if (cmd.equalsIgnoreCase("Vermelho")) {
    definirCorRGB(255, 0, 0, "Vermelho");
    modoTemporizadoRGB = true;
    tempoPiscaRGB = millis();
    Serial.println("[CMD] Vermelho por 1s");
  } else if (cmd.equalsIgnoreCase("Amarelo")) {
    definirCorRGB(255, 255, 0, "Amarelo");
    modoTemporizadoRGB = true;
    tempoPiscaRGB = millis();
    Serial.println("[CMD] Amarelo por 1s");
  } else if (cmd.equalsIgnoreCase("Azul")) {
    definirCorRGB(0, 0, 255, "Azul");
    modoTemporizadoRGB = true;
    tempoPiscaRGB = millis();
    Serial.println("[CMD] Azul por 1s");
  } else if (cmd.equalsIgnoreCase("Desativar Temperatura")) {
    ativadoTemperatura = false;
  } else if (cmd.equalsIgnoreCase("Ativar Temperatura")) {
    ativadoTemperatura = true;
  } else if (cmd.equalsIgnoreCase("Desativar Detector")) {
    ativadoDetector = false;
  } else if (cmd.equalsIgnoreCase("Ativar Detector")) {
    ativadoDetector = true;
  } else if (cmd.equalsIgnoreCase("Desativar Buzzer")) {
    ativadoBuzzer = false;
  } else if (cmd.equalsIgnoreCase("Ativar Buzzer")) {
    ativadoBuzzer = true;
  } else {
    Serial.print("[CMD] Desconhecido: ");
    Serial.println(cmd);
  }
}

void setup() {
  Serial.begin(115200);
  delay(1500);

  // Configuração dos pinos
  pinMode(PIN_LED_R, OUTPUT);
  pinMode(PIN_LED_G, OUTPUT);
  pinMode(PIN_LED_B, OUTPUT);
  pinMode(PIN_BUZZER, OUTPUT);

  pinMode(PIN_POT,  INPUT);
  pinMode(PIN_LDR,  INPUT);
  pinMode(PIN_TEMP, INPUT);

  pinMode(PIN_BOTAO, INPUT_PULLUP);
  attachInterrupt(digitalPinToInterrupt(PIN_BOTAO), tratarInterrupcaoBotao, FALLING);

  // Estado inicial padrão das variáveis
  ligadoPainel       = true;
  ativadoTemperatura = true;
  ativadoDetector    = true;
  ativadoBuzzer      = true;
  botao              = sistemaAtivoBotao;
  corAtual           = "Desligado";

  // Inicialização do Arduino IoT Cloud
  initProperties();
  ArduinoCloud.begin(ArduinoIoTPreferredConnection);
  setDebugMessageLevel(2);
  ArduinoCloud.printDebugInfo();

  Serial.println("--- Sistema de Lampada Inteligente IoT Inicializado ---");
}

void loop() {
  // Mantém a conexão com o Arduino IoT Cloud ativa
  ArduinoCloud.update();

  // Mantém suporte a comandos via Monitor Serial
  if (Serial.available() > 0) {
    String comando = Serial.readStringUntil('\n');
    processarComando(comando);
  }

  // Leitura dos sensores e atualização das variáveis da nuvem
  float tempC  = lerTemperaturaC(PIN_TEMP);
  int valorLDR = analogRead(PIN_LDR);
  int valorPot = analogRead(PIN_POT);

  temperatura  = tempC;             // Envia temperatura para o Cloud
  luminosidade = valorLDR;          // Envia luminosidade para o Cloud
  botao        = sistemaAtivoBotao; // Envia estado lógico do botão para o Cloud

  bool emPerigoTemp   = (tempC < 0.0 || tempC > 25.0);
  bool ambienteEscuro = (valorLDR > LIMITE_LDR_ESCURO);

  // --- Telemetria Serial a cada 1s ---
  static unsigned long ultimoPrint = 0;
  if (millis() - ultimoPrint > 1000) {
    ultimoPrint = millis();

    Serial.print("Temperatura: ");
    if (ativadoTemperatura) {
      Serial.print(tempC, 1);
      Serial.print(" C");
      if (emPerigoTemp) Serial.print(" -> Perigo! Desligar!");
    } else {
      Serial.print("[SENSOR DESATIVADO]");
    }
    Serial.println();

    Serial.print("LDR: ");      Serial.print(valorLDR);
    Serial.print(" | Pot: ");   Serial.print(valorPot);
    Serial.print(" | Botao: "); Serial.print(botao ? "ON" : "OFF");
    Serial.println();

    Serial.print("Cor LED RGB: ");
    Serial.println(corAtual);
    Serial.println("------------------------------------------");
  }

  // --- Buzzer ---
  if (ativadoBuzzer && ativadoTemperatura && emPerigoTemp && sistemaAtivoBotao) {
    tone(PIN_BUZZER, 1000);
  } else {
    noTone(PIN_BUZZER);
  }

  // --- Controle do LED RGB ---
  if (modoTemporizadoRGB) {
    if (millis() - tempoPiscaRGB > 1000) {
      modoTemporizadoRGB = false;
    }
  } else {
    if (!sistemaAtivoBotao || !ligadoPainel ||
        (!ativadoTemperatura && emPerigoTemp) ||
        (!ativadoDetector && !ambienteEscuro)) {
      definirCorRGB(0, 0, 0, "Desligado");
    } else {
      definirCorPorEspectro(valorPot);
    }
  }
}

// =========================================================================
// FUNÇÕES DE CALLBACK DO ARDUINO IOT CLOUD (Executadas ao mexer no painel)
// =========================================================================

void onLigadoPainelChange() {
  Serial.print("[CLOUD] ligadoPainel alterado para: ");
  Serial.println(ligadoPainel ? "ON" : "OFF");
}

void onAtivadoTemperaturaChange() {
  Serial.print("[CLOUD] ativadoTemperatura alterado para: ");
  Serial.println(ativadoTemperatura ? "ON" : "OFF");
}

void onAtivadoDetectorChange() {
  Serial.print("[CLOUD] ativadoDetector alterado para: ");
  Serial.println(ativadoDetector ? "ON" : "OFF");
}

void onAtivadoBuzzerChange() {
  Serial.print("[CLOUD] ativadoBuzzer alterado para: ");
  Serial.println(ativadoBuzzer ? "ON" : "OFF");
}

void onComandoNuvemChange() {
  Serial.print("[CLOUD] Comando recebido: ");
  Serial.println(comandoNuvem);
  processarComando(comandoNuvem);
}
